{
  "name": "@alche/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "prisma", "public"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-public.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "cli": "tsx src/cli.ts",
    "seed": "tsx src/seed.ts",
    "e2e:setup": "tsx src/e2e-setup.ts"
  },
  "dependencies": {
    "@alche/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.6.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "luxon": "3.7.2",
    "openapi-types": "12.1.3",
    "prisma": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
