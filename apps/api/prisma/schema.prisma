generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.Citext
  passwordHash       String
  displayName        String
  role               String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lastFailedAt       DateTime? @db.Timestamptz(3)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  sessions        Session[]
  eventsRecorded  Event[]         @relation("RecordedEvents")
  eventsVoided    Event[]         @relation("VoidedEvents")
  ticketsRaised   Ticket[]        @relation("TicketRaisedBy")
  ticketsReviewed Ticket[]        @relation("TicketReviewedBy")
  importBatches   ImportBatch[]
  auditLogs       AuditLog[]
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  tokenHash        String   @unique
  userId           String   @db.Uuid
  ip               String?
  userAgent        String?
  lastSeenAt       DateTime @db.Timestamptz(3)
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([absoluteExpiresAt])
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.Citext
  firstName     String
  lastName      String
  email         String?  @unique @db.Citext
  phone         String?
  department    String
  jobTitle      String?
  category      String   @default("staff")
  active        Boolean  @default(true)
  importBatchId String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  importBatch ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  events      Event[]
  vehicles    Vehicle[]
  tickets     Ticket[]

  @@index([department])
  @@index([active])
}

model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  plate       String
  plateNorm   String
  make        String?
  model       String?
  colour      String?
  vehicleType String   @default("car")
  active      Boolean  @default(true)
  notes       String?
  employeeId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([plateNorm])
  @@index([employeeId])
}

model Event {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @db.Uuid
  occurredAt     DateTime  @db.Timestamptz(3)
  direction      String
  recordedBy     String    @db.Uuid
  source         String
  note           String?
  supersededById String?   @db.Uuid
  ticketId       String?   @db.Uuid
  voidedAt       DateTime? @db.Timestamptz(3)
  voidedBy       String?   @db.Uuid
  voidReason     String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recorder User     @relation("RecordedEvents", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider   User?    @relation("VoidedEvents", fields: [voidedBy], references: [id], onDelete: Restrict)

  @@index([employeeId, occurredAt])
  @@index([occurredAt])
  @@index([supersededById])
}

model Ticket {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @db.Uuid
  targetEventId       String?   @db.Uuid
  proposedDirection   String
  proposedOccurredAt  DateTime  @db.Timestamptz(3)
  reason              String
  status              String    @default("open")
  raisedBy            String    @db.Uuid
  raisedAt            DateTime  @default(now()) @db.Timestamptz(3)
  reviewedBy          String?   @db.Uuid
  reviewedAt          DateTime? @db.Timestamptz(3)
  hrDirection         String?
  hrOccurredAt        DateTime? @db.Timestamptz(3)
  appliedAt           DateTime? @db.Timestamptz(3)
  appliedEventId      String?   @db.Uuid
  reviewNote          String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  raiser   User     @relation("TicketRaisedBy", fields: [raisedBy], references: [id], onDelete: Restrict)
  reviewer User?    @relation("TicketReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([status, raisedAt])
  @@index([raisedBy, status])
}

model ImportBatch {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  filename    String
  dryRun      Boolean  @default(false)
  skipInvalid Boolean  @default(false)
  actorUserId String   @db.Uuid
  totalRows   Int
  created     Int
  updated     Int
  skipped     Int
  invalid     Int
  errors      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  actor     User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  reason       String?
  ip           String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}
